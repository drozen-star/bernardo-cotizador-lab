# =============================================================================
# Supplier Quote Autopilot — environment template
# =============================================================================
# Copy to `.env` and fill in. Every value below has a working default for local
# development EXCEPT the ones marked REQUIRED.
#
# `docker compose up` reads this file. Native local development reads
# `backend/.env` instead (see backend/.env.example) — the same variables, but
# Compose needs them at the repository root.
#
# NOTHING SECRET IS COMMITTED. `.env` is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# development | production
# `production` enables: no exception details in 500 responses, loud startup
# warnings about insecure defaults, and the SECRET_KEY check.
ENV=development
APP_NAME=Supplier Quote Autopilot

# REQUIRED for docker compose — it creates the postgres container with these.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=supplier_quote_db
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
PUBLIC_FORM_PORT=5174

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# NOTE ON THE HOST: this file is read by docker compose, so the host is
# `postgres` — the name of the compose service. `localhost` here would make the
# backend container try to reach a database inside itself, and every request would
# fail with a connection error. (The native-development template,
# backend/.env.example, uses `localhost` because there is no container then.)
#
# To point this stack at Neon instead of the bundled postgres service, replace
# DATABASE_URL with the POOLED connection string — the hostname contains
# `-pooler` — and DATABASE_URL_DIRECT with the direct (non-pooled) one:
#
#   postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# sslmode=require is mandatory on Neon.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/supplier_quote_db

# Used ONLY by Alembic, which must not run through PgBouncer's transaction
# pooling. Empty falls back to DATABASE_URL, which is correct for local compose.
DATABASE_URL_DIRECT=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates every existing session — the intended way to force a
# global sign-out.
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# URLs — set these to your real deployed origins
# -----------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Where the supplier-facing form is hosted (its own Vercel project).
PUBLIC_FORM_URL=http://localhost:5174

# CORS. Comma-separated. Replace the wildcard in production:
# ALLOWED_ORIGINS=https://supplier-quote-autopilot.vercel.app,https://quote-autopilot-form.vercel.app
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# LLM — a FREE OpenAI-compatible provider. See README "Free LLM provider setup".
# -----------------------------------------------------------------------------
# The client is provider-agnostic: only these three variables change.
#
#   Groq (default, fastest)   LLM_BASE_URL=https://api.groq.com/openai/v1
#                             LLM_MODEL=openai/gpt-oss-120b
#                             key: https://console.groq.com
#
#   OpenRouter (:free models) LLM_BASE_URL=https://openrouter.ai/api/v1
#                             LLM_MODEL=deepseek/deepseek-r1:free
#                             key: https://openrouter.ai
#
#   Google Gemini             LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                             LLM_MODEL=gemini-2.0-flash
#                             key: https://aistudio.google.com
#
# Leave LLM_API_KEY empty and the app still works end to end: quote parsing,
# follow-up drafting and the comparison narrative fall back to deterministic
# implementations. Nothing breaks without a key — it is just less fluent.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Free-tier guardrails. Groq's free tier is ~30 requests/minute and
# 14,400 requests/day per model. The client spaces requests out, caps in-flight
# concurrency, and retries 429/5xx with exponential backoff.
LLM_ENABLED=true
LLM_REQUESTS_PER_MINUTE=30
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=60

# How much thinking a REASONING model is allowed to do before it answers:
# low | medium | high, or empty to send nothing at all.
#
# Leave this at `low`. The default model above (openai/gpt-oss-120b) is a reasoning
# model that writes a reasoning trace before its JSON. At the provider's default
# trace length, Groq's free tier rejected the call outright — HTTP 400
# "max completion tokens reached before generating a valid document" — and every
# LLM feature quietly fell back to its deterministic path.
#
# Set it empty only when pointing LLM_MODEL at a non-reasoning model whose endpoint
# rejects the parameter. The app already skips it for models it knows cannot take it
# (llama, gemini, mistral and friends), so an empty value is rarely needed.
LLM_REASONING_EFFORT=low

# Hard ceiling on LLM calls in one scheduler sweep, so a backlog cannot burn a
# whole day's quota in one pass.
LLM_BATCH_MAX_CALLS=50

# -----------------------------------------------------------------------------
# Email — HTTPS API ONLY. There is no SMTP support, and there never will be:
# Render's free tier blocks outbound ports 25, 465 and 587.
# -----------------------------------------------------------------------------
# console | resend | sendgrid | mailgun | brevo
#
# `console` prints each message to the log and sends nothing — the local default,
# so you never accidentally email real suppliers from a dev machine.
EMAIL_PROVIDER=console

#   Resend    https://resend.com     (3,000 emails/month free)
#   SendGrid  https://sendgrid.com   (100 emails/day free)
#   Mailgun   https://mailgun.com    (100 emails/day free)
#   Brevo     https://brevo.com      (300 emails/day free)
EMAIL_API_KEY=

# Optional endpoint override (self-hosted relay or a regional API host).
EMAIL_API_URL=

# Must be an address on a domain you have verified with the provider, or sends are
# rejected. Most providers ship a test sender you can use immediately.
MAIL_FROM=Supplier Quote Autopilot <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# File storage — Render's free tier has NO persistent disk, so production must use
# object storage. `local` is for development only.
# -----------------------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.csv,.xlsx,.doc,.docx

# Any S3-compatible service works. Free-tier options:
#   Cloudflare R2         10 GB storage, no egress fees
#   Backblaze B2          10 GB storage
#   Neon Object Storage   included with Neon
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set when the bucket has a public domain or CDN in front of it. Leave empty and
# files are proxied through the backend's /files route instead.
S3_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Public form: link lifetime and anti-spam
# -----------------------------------------------------------------------------
# How long a supplier's private link stays usable.
INVITATION_TTL_DAYS=30

# Per-IP sliding windows enforced on every public endpoint. The honeypot runs
# first and is always active; these are the second layer.
PUBLIC_RATE_LIMIT_PER_MINUTE=20
PUBLIC_RATE_LIMIT_PER_HOUR=60

# CAPTCHA is optional because it needs a site key. none | turnstile | hcaptcha
# Both are free. The form works fully with `none`.
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# -----------------------------------------------------------------------------
# Follow-ups
# -----------------------------------------------------------------------------
# false -> every reminder is written as a DRAFT and waits for the buyer's approval
# true  -> reminders are sent automatically
#
# This flag does NOT affect awarding: awarding a supplier always requires an
# explicit human approval, in every configuration.
AUTO_SEND_FOLLOWUPS=false

# Hours after the last message before the next reminder, one entry per reminder.
# Default: chase after 3 days, then after 7 days.
FOLLOWUP_INTERVALS_HOURS=72,168

# Also remind N hours before the deadline if nothing has arrived, regardless of
# the intervals above — a reminder that lands after the cut-off is worthless.
FOLLOWUP_BEFORE_DEADLINE_HOURS=48

MAX_FOLLOWUPS_PER_INVITATION=3
# How many times to chase the *specific fields* a supplier left blank.
MAX_INCOMPLETE_REMINDERS=2

# In-process scheduler. Render's free tier spins down after 15 idle minutes, so
# this is best-effort; the cron endpoint below is the reliable driver.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# Shared secret for POST /internal/scheduler/tick. The endpoint is DISABLED while
# this is empty. Generate one and point a free external cron at it — see the
# README's "Keeping the free tier alive" section.
#   curl -X POST https://YOUR-SERVICE.onrender.com/internal/scheduler/tick \
#        -H "X-Scheduler-Secret: $SCHEDULER_SECRET"
SCHEDULER_SECRET=

# -----------------------------------------------------------------------------
# Read-only demo
# -----------------------------------------------------------------------------
# Serves GET /demo/workspace: a sample tender a visitor can read with no account.
#
# The payload is a committed snapshot generated by
#   python -m scripts.seed_demo --dump-demo
# through the real services and the real scoring engine, so it shows genuine
# output — the nine criteria, the cap on a quote missing a required licence, GST
# derived from a stated rate — while touching no database. A file rather than a
# query on purpose: a live endpoint would read a workspace out of whatever database
# this deployment points at, and an anonymous visitor must never be able to read
# somebody's real suppliers and prices.
#
# Nothing under /demo accepts a write, so "view only" is a property of the route
# table rather than a rule the front end is trusted to keep. Set false on a
# deployment that should not carry a demo at all.
DEMO_MODE_ENABLED=true

# -----------------------------------------------------------------------------
# Lab Bernardo — WhatsApp
# -----------------------------------------------------------------------------
# Número de WhatsApp de Bernardo para el link wa.me que va en el mail de batch
# (POST /rfq-batches/import). Formato E.164 SIN el "+": código de país + número,
# p. ej. 5491122334455. Vacío = el mail sale sin el link y se loguea un warning.
BERNARDO_WA_NUMBER=

# -----------------------------------------------------------------------------
# Procurement defaults
# -----------------------------------------------------------------------------
# What a new RFQ is, unless the buyer says otherwise.
#   service  building maintenance and minor works — electrical, mechanical,
#            plumbing, painting, ACMV, and the rest. Selects the service field
#            contract, the service scoring weights, and the services vocabulary.
#   goods    supplies. Restores the original behaviour: MOQ, Incoterms, lead time,
#            freight and duties.
DEFAULT_PROCUREMENT_TYPE=service

# -----------------------------------------------------------------------------
# Comparison engine
# -----------------------------------------------------------------------------
# Prices are normalized into this currency before anything is compared, and it is
# the default for a new RFQ. SGD because this product is aimed at Singapore
# facilities and building-services procurement — set your own for elsewhere.
BASE_CURRENCY=SGD

# GST (or the local equivalent) as a percentage. Applied when a supplier states a
# rate but no explicit tax amount, so the final cost is not a surprise. 9% is the
# current Singapore rate. Set to 0 for a buyer who is not GST-registered or for a
# country with no such tax.
DEFAULT_GST_RATE=9.0

# FX rates are a static, documented baseline table rather than a live feed, so a
# comparison never depends on a third-party API staying up. Override only the
# currencies you care about; every result carries the rate and its as-of date.
# FX_RATES_JSON={"USD": 1.34, "MYR": 4.7, "EUR": 1.45}

# Per-criterion weights. Leave empty for the procurement type's defaults.
#
#   services  price 0.40, response_time 0.15, risk 0.15, compliance 0.10,
#             lead_time 0.05, payment_terms 0.05, validity 0.05, warranty 0.05,
#             moq 0.00
#   goods     price 0.45, lead_time 0.20, payment_terms 0.10, moq 0.05,
#             validity 0.05, warranty 0.05, risk 0.10
#
# DEFAULT_SCORING_WEIGHTS_JSON={"price": 0.5, "response_time": 0.2, "risk": 0.3}

# Lead times at or above this many days are flagged as a risk for the buyer.
LEAD_TIME_RISK_DAYS=90
# Quotes expiring within this many days are flagged as "expiring soon".
QUOTE_VALIDITY_WARNING_DAYS=7

# -----------------------------------------------------------------------------
# Frontend build args (Vite bakes these in at BUILD time, not run time)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
# The base repo's name for the same value; both are accepted.
VITE_API_BASE_URL=http://localhost:8000
